   "source": [
    "#Count Consonants in a string\n",
    "text = input(\"Enter a String: \")\n",
    "count = 0\n",
    "for ch in text:\n",
    "    if ch not in \"aeiouAEIOU\":\n",
    "        count += 1\n",
    "print(\"Number of vowels:\", count)"
   ]
