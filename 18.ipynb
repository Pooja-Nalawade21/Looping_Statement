   "source": [
    "#print prime number between 1 and 50\n",
    "for i in range(2, 51):\n",
    "    count = 0\n",
    "    for j in range(1, i + 1):\n",
    "        if i % j == 0:\n",
    "            count += 1\n",
    "    if count == 2:\n",
    "        print(i)"
