   "source": [
    "#print first n multiples of number\n",
    "num = int(input(\"Enter a number : \"))\n",
    "n = int(input(\"Enter how many multiples : \"))\n",
    "i = 1\n",
    "while i <= n:\n",
    "    print(num * i)\n",
    "    i += 1\n"
   ]
