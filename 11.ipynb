   "source": [
    "#Count number of digits in a number\n",
    "num = int(input(\"Enter a number: \"))\n",
    "count = 0\n",
    "while num > 0:\n",
    "    num = num // 10\n",
    "    count = count + 1\n",
    "print(\"Number of digits =\", count)\n"
   ]
