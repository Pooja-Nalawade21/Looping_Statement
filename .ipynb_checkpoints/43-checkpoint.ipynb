   "source": [
    "#Calculate sum of square of first n numbers\n",
    "n = int(input(\"Enter a number : \"))\n",
    "sum = 0\n",
    "for i in range(1, n + 1):\n",
    "    sum = sum + i**2\n",
    "print(\"Sum =\", sum)\n",
    "\n"
   ]
  }
