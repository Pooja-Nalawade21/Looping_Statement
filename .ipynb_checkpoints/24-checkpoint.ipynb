   "source": [
    "#to check vowel count in string\n",
    "text = input(\"Enter a String: \")\n",
    "count = 0\n",
    "for ch in text:\n",
    "    if ch in \"aeiouAEIOU\":\n",
    "        count += 1\n",
    "print(\"Number of vowels:\", count)"
   ]
  }
