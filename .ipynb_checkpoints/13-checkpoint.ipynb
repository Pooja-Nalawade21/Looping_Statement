   "source": [
    "#a number is Palindrome or not\n",
    "num=int(input(\"Enter a Number : \"))\n",
    "original_num=num\n",
    "rev=0\n",
    "while num>0:\n",
    "    digit=num % 10\n",
    "    rev=rev*10+digit\n",
    "    num=num//10\n",
    "if rev==original_num :\n",
    "    print(\"The Number is Palindrome...\")\n",
    "else :\n",
    "     print(\"The Number is Not Palindrome...\")\n",
    "    "
   ]
  }
