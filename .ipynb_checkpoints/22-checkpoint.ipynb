   ],
   "source": [
    "#Find sum of even digits in a number\n",
    "\n",
    "num = int(input(\"Enter the number =\"))\n",
    "sum=0\n",
    "\n",
    "while num>0:\n",
    "    digit = num%10\n",
    "\n",
    "    if digit % 2 == 0:\n",
    "        sum = sum + digit\n",
    "\n",
    "    num = num // 10\n",
    "\n",
    "print(\"Sum of even digits in the number =\", sum)"
   ]
  },
