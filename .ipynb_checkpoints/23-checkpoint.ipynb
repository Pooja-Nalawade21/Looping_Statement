   "source": [
    "#find sum of odd digits\n",
    "\n",
    "num = int(input(\"Enter the number =\"))\n",
    "sum=0\n",
    "\n",
    "while num>0:\n",
    "    digit = num%10\n",
    "\n",
    "    if digit % 2 == 1:\n",
    "        sum = sum + digit\n",
    "\n",
    "    num = num // 10\n",
    "\n",
    "print(\"Sum of odd digits in the number =\", sum)"
   ]
  }
 ],
