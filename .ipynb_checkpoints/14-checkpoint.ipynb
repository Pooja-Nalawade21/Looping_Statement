   "source": [
    "#print fibonacci series up to n\n",
    "n=int(input(\"Enter the Number of Terms : \"))\n",
    "f=1\n",
    "a=0\n",
    "count=0\n",
    "while count<n:\n",
    "    print(f,end=\" \")\n",
    "    c=f+a\n",
    "    a=f\n",
    "    f=c\n",
    "    count=count+1"
   ]
