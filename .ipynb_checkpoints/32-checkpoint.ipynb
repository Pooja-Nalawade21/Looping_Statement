   "source": [
    "#calculate power of number without using pow() function\n",
    "base = int(input(\"Enter the Number: \"))\n",
    "power = int(input(\"Enter the power: \"))\n",
    "result = 1\n",
    "for i in range(power):\n",
    "    result = result * base\n",
    "print(\"Power of Given Number  =\", result)"
