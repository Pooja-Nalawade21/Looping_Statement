   "source": [
    "#print  numbers which are perfect cube number between 1 to 100\n",
    "for num in range(1, 101):\n",
    "    i = 1\n",
    "\n",
    "    while i * i * i <= num:\n",
    "        if i * i * i == num:\n",
    "            print(num)\n",
    "        i += 1"
   ]
