   "source": [
    "#count total words in astring\n",
    "text = input(\"Enter a string : \")\n",
    "count = 1\n",
    "for ch in text:\n",
    "    if ch == \" \":\n",
    "        count += 1\n",
    "print(\"Total words =\", count)\n"
   ]
