   "source": [
    "#find sum of digits of number\n",
    "num=int(input(\"Enter a Number : \"))\n",
    "sum=0\n",
    "rev=0\n",
    "for i in range(1,num):\n",
    "    digit=num%10\n",
    "    rev=rev*10+digit\n",
    "    num=num//10\n",
    "    sum=sum+digit\n",
    "print(\"Sum of Digits : \",sum)"
   ]
