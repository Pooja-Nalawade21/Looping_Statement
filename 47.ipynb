   ],
   "source": [
    "#find products of a digit of number\n",
    "num = int(input(\"Enter a number : \"))\n",
    "product = 1\n",
    "while num > 0:\n",
    "    digit = num % 10\n",
    "    product = product * digit\n",
    "    num = num // 10\n",
    "print(\"Product =\", product)"
   ]
