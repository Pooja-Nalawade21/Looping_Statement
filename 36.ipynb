   "source": [
    "#find sum of numbers entered by user until 0 is entered\n",
    "num = int(input(\"Enter a number : \"))\n",
    "sum = 0\n",
    "while num != 0:\n",
    "    sum = sum + num\n",
    "    num = int(input(\"Enter a number : \"))\n",
    "\n",
    "print(\"Sum =\", sum)"
   ]
