   "source": [
    "#Reverse a number using while loop\n",
    "num=int(input(\"Enter a Number : \"))\n",
    "rev=0\n",
    "while num!=0:\n",
    "    digit=num%10\n",
    "    rev=rev*10+digit\n",
    "    num=num//10 \n",
    "print(\"The Reverse Number : \",rev)\n",
    "    "
   ]
