   "source": [
    "#Check whether string is palindrome or not \n",
    "text = input(\"Enter a string: \")\n",
    "rev = \"\"\n",
    "for ch in text:\n",
    "    rev = ch + rev\n",
    "if text == rev:\n",
    "    print(\"Palindrome\")\n",
    "else:\n",
    "    print(\"Not a Palindrome\")\n"
   ]
