   ],
   "source": [
    "#find smallest no. in digit\n",
    "num = int(input(\"Enter a number : \"))\n",
    "\n",
    "smallest = 9\n",
    "\n",
    "while num > 0:\n",
    "    digit = num % 10\n",
    "\n",
    "    if digit < smallest:\n",
    "        smallest = digit\n",
    "\n",
    "    num = num // 10\n",
    "\n",
    "print(\"Smallest digit =\", smallest)"
   ]
  },
