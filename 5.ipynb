   "source": [
    "#print multiplication table of given number\n",
    "num=int(input(\"Enter a Number :  \"))\n",
    "a=1\n",
    "while a <= 10 :\n",
    "    print(num, \"x\" ,a, \"=\" ,num * a)\n",
    "    a = a + 1"
   ]
